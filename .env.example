# Postgres connection string — free tier at https://neon.tech
# (use the direct connection string; run `npx prisma db push` once to create tables)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Where the app is served — used for redirects and absolute links.
# In production this is your Vercel URL, e.g. https://hsushi.vercel.app
APP_URL="http://localhost:3000"

# Long random string. REQUIRED in production (generate: openssl rand -hex 32).
SESSION_SECRET=""

# Optional: restrict sign-in to a single email domain.
# Leave blank to allow any email address.
# Example: example.com
ALLOWED_EMAIL_DOMAIN=""

# Optional: comma-separated emails granted admin (can resolve any market).
# ADMIN_EMAILS="alice@example.com,bob@example.com"
ADMIN_EMAILS=""

# Starting balance in cents (default 100000 = 1,000 LittleSky pennies).
STARTING_BALANCE_CENTS="100000"
